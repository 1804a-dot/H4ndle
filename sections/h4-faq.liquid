  </div>
</section>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "@id": {{ canonical_url | append: '#faq' | json }},
  "url": {{ canonical_url | append: '#preguntas' | json }},
  "name": "Preguntas frecuentes sobre empaques personalizados de H4NDLE",
  "inLanguage": "es-MX",
  "mainEntity": [
  {%- for h4_item in h4_faq_items %}
  {%- assign h4_qa = h4_item | split: '^^^' %}
    {
      "@type": "Question",
      "name": {{ h4_qa.first | strip_html | strip | json }},
      "acceptedAnswer": {
        "@type": "Answer",
        "text": {{ h4_qa.last | strip_html | strip | json }}
      }
    }{% unless forloop.last %},{% endunless %}
  {%- endfor %}
  ]
}
</script>

