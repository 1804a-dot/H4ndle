{%- comment -%} H4 · Contraseña de la tienda (layout standalone, sin header/footer) {%- endcomment -%}
<main class="st-password">
  <div class="wrap">
    <svg class="st-password-wm" viewBox="0 0 940.48 168.1" aria-label="H4NDLE" role="img"><use href="#wm"/></svg>
    <h1>Estamos preparando algo nuevo.</h1>
    <p class="lede">H4NDLE vuelve pronto con su tienda en línea. Si tienes la contraseña, entra aquí.</p>

    {%- form 'storefront_password' -%}
      {%- if form.errors -%}
      <div class="st-error-list">{{ form.errors | default_errors }}</div>
      {%- endif -%}
      <label for="StorePassword">{{ 'password_page.login_form_password_label' | t }}</label>
      <input type="password" id="StorePassword" name="password" autocomplete="current-password" required>
      <button type="submit" class="btn">{{ 'password_page.login_password_button' | t }}</button>
    {%- endform -%}

    <p class="st-admin-link">{{ 'password_page.admin_link_html' | t }}</p>
  </div>
</main>

{% schema %}
{
  "name": "H4 · Contraseña",
  "settings": []
}
{% endschema %}
