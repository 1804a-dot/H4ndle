{%- if template.name == 'index' -%}
  {%- assign h4_home = '' -%}
  {%- assign h4_brand = '#main' -%}
{%- else -%}
  {%- assign h4_home = routes.root_url -%}
  {%- assign h4_brand = routes.root_url -%}
{%- endif -%}
<footer class="foot" data-tone="dark">
  <div class="wrap">
    <div class="trust">
      <div><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M13 2L4 14h7l-1 8 9-12h-7l1-8Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg><p style="margin:0"><b>Entrega rápida</b><span>En 4 días hábiles o es gratis.</span></p></div>
      <div><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 19c8 0 14-6 14-14-8 0-14 6-14 14Zm0 0l7-7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg><p style="margin:0"><b>100% papel</b><span>No usamos plásticos.</span></p></div>
      <div><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7h11v9H3zM14 10h4l3 3v3h-7M7 19a2 2 0 1 0 0-.01M17 19a2 2 0 1 0 0-.01" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg><p style="margin:0"><b>Envíos</b><span>A toda la república mexicana.</span></p></div>
      <div><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l7 3v6c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6l7-3Zm-3 9l2 2 4-4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" stroke-linecap="round"/></svg><p style="margin:0"><b>Pago seguro</b><span>Compra en línea, sin cotizar.</span></p></div>
    </div>
    <div class="cols">
      <div class="about"><svg class="wm" viewBox="0 0 940.48 168.1" aria-label="H4NDLE" role="img"><use href="#wm"/></svg><p>La plataforma de empaque de marca para pymes y Dark Kitchens. Síguenos en Instagram <a href="https://www.instagram.com/handlemx/" rel="noopener" aria-label="@handlemx en Instagram">@handlemx</a>.</p></div>
      <nav aria-labelledby="ft-tienda"><h4 id="ft-tienda">Tienda</h4><ul><li><a href="{{ h4_home }}#tienda" data-filter="fastfood" aria-label="Empaques para Fast Food">Fast Food</a></li>{%- comment -%}Pizza: oculto por pedido del cliente (10-oct-2026), no borrado. Para volver a mostrarlo, quita este comment: <li><a href="{{ h4_home }}#tienda" data-filter="pizza" aria-label="Empaques para Pizza">Pizza</a></li>{%- endcomment -%}<li><a href="{{ h4_home }}#tienda" data-filter="sushi" aria-label="Empaques para Asian &amp; Sushi">Asian &amp; Sushi</a></li><li><a href="{{ h4_home }}#tienda" data-filter="bakery" aria-label="Empaques para Bakery &amp; Desserts">Bakery &amp; Desserts</a></li></ul></nav>
      <nav aria-labelledby="ft-ayuda"><h4 id="ft-ayuda">Ayuda</h4><ul><li><a href="{{ h4_home }}#sistema">Cómo funciona</a></li><li><a href="{{ h4_home }}#garantia">Garantía</a></li><li><a href="{{ h4_home }}#preguntas">Preguntas frecuentes</a></li></ul></nav>
      <div><h4 id="ft-contacto">Contacto</h4><address style="font-style:normal"><ul><li><a href="tel:+525545580107" aria-label="Llamar al 55 45 58 01 07">55 45 58 01 07</a></li><li><a href="mailto:contacto@handlemx.com" aria-label="Escribir a contacto@handlemx.com">contacto@handlemx.com</a></li><li>Atención 24/7</li></ul></address></div>
    </div>
    <div class="bigmark" aria-hidden="true"><svg viewBox="0 0 940.48 168.1"><use href="#wm"/></svg></div>
    <style>
.h4-social{padding:8px 0 28px}
.h4-social ul{list-style:none;margin:0;padding:0;display:flex;flex-wrap:wrap;gap:8px}
.h4-social li{margin:0;padding:0}
.h4-social__i{display:grid;place-items:center;width:44px;height:44px;border-radius:50%;border:1px solid var(--line-dark);color:var(--paper);opacity:.88;text-decoration:none;transition:opacity .2s,color .2s,border-color .2s,background-color .2s}
.h4-social__i svg{width:24px;height:24px;display:block;fill:currentColor}
a.h4-social__i:hover{opacity:1;color:#fff;border-color:rgba(238,243,255,.55);background:rgba(238,243,255,.08)}
a.h4-social__i:focus-visible{opacity:1;outline:3px solid #8CC4FF;outline-offset:3px;border-radius:50%}
@media (max-width:520px){.h4-social ul{gap:0;justify-content:space-between}.h4-social__i{width:40px;height:40px}}
@media (max-width:1400px){.foot{padding-bottom:calc(88px + env(safe-area-inset-bottom,0px))}}
@media (prefers-reduced-motion:reduce){.h4-social__i{transition:none}}
    </style>
    {%- liquid
      assign h4_wa_num = settings.h4_whatsapp_number | default: '525545580107' | remove: ' ' | remove: '+' | remove: '-' | remove: '(' | remove: ')'
      if h4_wa_num == blank
        assign h4_wa_num = '525545580107'
      endif
      assign h4_wa_msg = settings.h4_whatsapp_message | default: 'Hola, quiero información sobre empaques con mi marca.'
      assign h4_wa_enc = h4_wa_msg | url_encode | replace: '+', '%20'
      assign h4_wa_url = 'https://wa.me/' | append: h4_wa_num | append: '?text=' | append: h4_wa_enc
      assign h4_nets = 'instagram,facebook,tiktok,youtube,linkedin,x,pinterest,whatsapp' | split: ','
    -%}
