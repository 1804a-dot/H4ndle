{%- comment -%}
  Botón flotante de WhatsApp (todas las páginas). Número y mensaje: Configuración del tema > Contacto y redes
  (settings.h4_whatsapp_number / settings.h4_whatsapp_message). z-index 70: debajo del scrim (90), del cajón (95) y del toast (99) del carrito.
{%- endcomment -%}
{%- liquid
  assign h4_wa_num = settings.h4_whatsapp_number | default: '525545580107' | remove: ' ' | remove: '+' | remove: '-' | remove: '(' | remove: ')'
  if h4_wa_num == blank
    assign h4_wa_num = '525545580107'
  endif
  assign h4_wa_msg = settings.h4_whatsapp_message | default: 'Hola, quiero información sobre empaques con mi marca.'
  assign h4_wa_enc = h4_wa_msg | url_encode | replace: '+', '%20'
-%}
<style>
.h4-wa{position:fixed;right:calc(16px + env(safe-area-inset-right,0px));bottom:calc(20px + env(safe-area-inset-bottom,0px));z-index:70;width:56px;height:56px;display:grid;place-items:center;border-radius:50%;background:#128C7E;color:#fff;text-decoration:none;box-shadow:0 12px 26px -10px rgba(4,10,30,.6),0 2px 6px rgba(4,10,30,.25);transition:transform .25s var(--ease-out,ease),background-color .25s,opacity .3s,visibility .3s}
.h4-wa svg{width:30px;height:30px;display:block;fill:currentColor}
.h4-wa:hover{background:#0E7A6E;transform:translateY(-2px)}
.h4-wa:active{transform:none}
.h4-wa:focus-visible{outline:3px solid var(--accent,#007BE8);outline-offset:3px;border-radius:50%}
.h4-wa__tip{position:absolute;right:calc(100% + 12px);top:50%;transform:translate(6px,-50%);background:var(--ink,#0B1633);color:#fff;font:500 .84rem/1 var(--f-body,system-ui,sans-serif);padding:10px 14px;border-radius:10px;white-space:nowrap;opacity:0;visibility:hidden;pointer-events:none;box-shadow:0 12px 28px -14px rgba(4,10,30,.7);transition:opacity .2s,transform .25s var(--ease-out,ease),visibility .2s}
@media (hover:hover) and (pointer:fine){.h4-wa:hover .h4-wa__tip,.h4-wa:focus-visible .h4-wa__tip{opacity:1;visibility:visible;transform:translate(0,-50%)}}
body:has(#cart.on) .h4-wa{opacity:0;visibility:hidden;pointer-events:none}
@media (max-width:720px){
  .h4-wa{width:52px;height:52px;right:calc(14px + env(safe-area-inset-right,0px));bottom:calc(16px + env(safe-area-inset-bottom,0px))}
  .h4-wa svg{width:28px;height:28px}
  .h4-wa__tip{display:none}
  body:has(#toast.on) .h4-wa{transform:translateY(-80px)}
}
@media (prefers-reduced-motion:reduce){.h4-wa,.h4-wa__tip{transition:none}.h4-wa:hover{transform:none}}
@media print{.h4-wa{display:none}}
</style>
<a class="h4-wa" href="https://wa.me/{{ h4_wa_num }}?text={{ h4_wa_enc }}" target="_blank" rel="noopener" aria-label="Escríbenos por WhatsApp"><span class="h4-wa__tip" aria-hidden="true">Habla con una persona real</span><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg></a>
