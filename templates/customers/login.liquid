{%- comment -%} H4 · Iniciar sesión {%- endcomment -%}
<section class="st-section" data-tone="light" aria-labelledby="st-login-title">
  <div class="wrap st-form-wrap">
    <p class="kicker"><svg aria-hidden="true"><use href="#four"/></svg>Mi cuenta</p>
    <h1 class="display h2" id="st-login-title">{{ 'customer.login_page.title' | t }}</h1>

    {%- form 'customer_login', class: 'st-form st-mt' -%}
      {%- if form.errors -%}
      <div class="st-error-list">{{ form.errors | default_errors }}</div>
      {%- endif -%}

      <label for="CustomerEmail">{{ 'customer.login_page.email' | t }}</label>
      <input type="email" id="CustomerEmail" name="customer[email]" autocomplete="email" autocorrect="off" autocapitalize="off" required>

      {%- if form.password_needed -%}
      <label for="CustomerPassword">{{ 'customer.login_page.password' | t }}</label>
      <input type="password" id="CustomerPassword" name="customer[password]" autocomplete="current-password" required>
      {%- endif -%}

      <div class="st-actions-row">
        <button type="submit" class="btn">{{ 'customer.login_page.sign_in' | t }}</button>
        {%- if form.password_needed -%}
        <a class="st-sm-link" href="#recover">{{ 'customer.login_page.forgot_password' | t }}</a>
        {%- endif -%}
      </div>
    {%- endform -%}

    {%- if form.password_needed -%}
    <div id="recover" class="st-recover-panel">
      <h2>{{ 'customer.recover_password.title' | t }}</h2>
      <p class="st-note">{{ 'customer.recover_password.subtext' | t }}</p>
      {%- form 'recover_customer_password', class: 'st-form st-mt' -%}
        {%- if form.posted_successfully? -%}
        <p class="st-success">{{ 'customer.recover_password.success' | t }}</p>
        {%- endif -%}
        {%- if form.errors -%}
        <div class="st-error-list">{{ form.errors | default_errors }}</div>
        {%- endif -%}
        <label for="RecoverEmail">{{ 'customer.login_page.email' | t }}</label>
        <input type="email" id="RecoverEmail" name="email" autocomplete="email" autocorrect="off" autocapitalize="off" required>
        <div class="st-actions-row">
          <button type="submit" class="btn">{{ 'customer.login_page.sign_in' | t }}</button>
          <a class="st-sm-link" href="{{ routes.account_login_url }}">{{ 'customer.login_page.cancel' | t }}</a>
        </div>
      {%- endform -%}
      {%- if form.posted_successfully? -%}
      <script>if(!window.location.hash){window.location.hash='recover'}</script>
      {%- endif -%}
    </div>
    {%- endif -%}

    <hr class="st-divider">
    <p class="st-note">{{ 'customer.login_page.no_account' | t }} <a href="{{ routes.account_register_url }}">{{ 'customer.login_page.create_account' | t }}</a></p>
  </div>
</section>
