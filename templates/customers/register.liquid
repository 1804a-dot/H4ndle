{%- comment -%} H4 · Crear cuenta {%- endcomment -%}
<section class="st-section" data-tone="light" aria-labelledby="st-register-title">
  <div class="wrap st-form-wrap">
    <p class="kicker"><svg aria-hidden="true"><use href="#four"/></svg>Mi cuenta</p>
    <h1 class="display h2" id="st-register-title">{{ 'customer.register.title' | t }}</h1>

    {%- form 'create_customer', class: 'st-form st-mt' -%}
      {%- if form.errors -%}
      <div class="st-error-list">{{ form.errors | default_errors }}</div>
      {%- endif -%}

      <label for="RegisterFirstName">{{ 'customer.register.first_name' | t }}</label>
      <input type="text" id="RegisterFirstName" name="customer[first_name]" autocomplete="given-name">

      <label for="RegisterLastName">{{ 'customer.register.last_name' | t }}</label>
      <input type="text" id="RegisterLastName" name="customer[last_name]" autocomplete="family-name">

      <label for="RegisterEmail">{{ 'customer.register.email' | t }}</label>
      <input type="email" id="RegisterEmail" name="customer[email]" autocomplete="email" autocorrect="off" autocapitalize="off" required>

      <label for="RegisterPassword">{{ 'customer.register.password' | t }}</label>
      <input type="password" id="RegisterPassword" name="customer[password]" autocomplete="new-password" required>

      <div class="st-actions-row">
        <button type="submit" class="btn">{{ 'customer.register.submit' | t }}</button>
      </div>
    {%- endform -%}

    <hr class="st-divider">
    <p class="st-note">{{ 'customer.register.already_have' | t }} <a href="{{ routes.account_login_url }}">{{ 'customer.register.sign_in' | t }}</a></p>
  </div>
</section>
